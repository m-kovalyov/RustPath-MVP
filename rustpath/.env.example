# Use letters/digits/hex for the DB password so the connection URI needs no escaping.
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
RUNNER_SECRET=replace_with_64_random_hex_characters
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
WEB_BIND=127.0.0.1
RUNNER_IMAGE=rust:1.99.0-slim-bookworm
